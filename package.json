{
  "name": "quietops",
  "version": "0.0.0",
  "private": true,
  "description": "Release-evidence stewardship for small software teams.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "format": "prettier --write package.json tsconfig.json \"packages/**/*.{json,ts}\"",
    "format:check": "prettier --check package.json tsconfig.json \"packages/**/*.{json,ts}\"",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "npm run format:check && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
