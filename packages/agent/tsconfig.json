{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "ESNext.Disposable"],
    "outDir": "dist",
    "paths": {
      "@quietops/adapters": ["./../adapters/src/index.ts"],
      "@quietops/contracts": ["./../contracts/src/index.ts"]
    },
    "rootDir": ".",
    "tsBuildInfoFile": "dist/agent.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "references": [
    {
      "path": "../adapters"
    },
    {
      "path": "../contracts"
    }
  ]
}
